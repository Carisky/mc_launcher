{
  "name": "mc-launcher",
  "version": "1.0.1",
  "main": "main.js",
  "description": "Custom Minecraft Launcher with modpack sync and offline login.",
  "author": "Custom Launcher Team",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:portable-remote-push": "node ./scripts/buildPortableRemotePush.js"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "minecraft-launcher-core": "^3.17.1",
    "node-fetch": "^2.7.0",
    "prismarine-nbt": "^2.7.0",
    "rcon-client": "^4.2.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.custom.launcher",
    "productName": "Compass MC Launcher",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "config.json",
      "config.example.json",
      "runtime/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
