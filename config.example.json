{
  "GAME_ROOT": "./runtime",
  "FORGE_VERSION": "1.12.2-forge-14.23.5.2860",
  "DEFAULT_RAM_MB": 4096,
  "MIN_RAM_MB": 2048,
  "JAVA_ARGS": [
    "-XX:-UseAdaptiveSizePolicy",
    "-XX:-OmitStackTraceInFastThrow"
  ],
  "AUTH": {
    "provider": "drasl",
    "domain": "drasl.example.com",
    "baseUrl": "https://drasl.example.com",
    "allowRegistration": false,
    "authlibInjector": {
      "version": "1.2.6",
      "downloadUrl": "https://github.com/yushijinhun/authlib-injector/releases/download/v1.2.6/authlib-injector-1.2.6.jar",
      "sha256": "6DFF7951C41D61EBA78F9B034BE610ADE0E80D3309300742057D1866375D0427"
    }
  },
  "APP_UPDATES": {
    "ENABLED": true,
    "ENFORCE": true,
    "CHANNEL": "stable",
    "github": {
      "OWNER": "your-github",
      "REPO": "mc-launcher-distro",
      "ASSET_NAME": "Compass MC Launcher Portable.exe"
    }
  },
  "MODPACKS": [
    {
      "id": "dtm",
      "name": "DTM Adventures",
      "description": "PvE/RPG сборка c MagicTech и Thaumcraft, синхронизация из GitHub.",
      "icon": "https://raw.githubusercontent.com/github/explore/main/topics/minecraft/minecraft.png",
      "forgeVersion": "1.12.2-forge-14.23.5.2860",
      "github": {
        "OWNER": "your-github",
        "REPO": "your-modpack-repo",
        "BRANCH": "main",
        "SUBDIR": "mods"
      }
    },
    {
      "id": "vanilla-plus",
      "name": "Vanilla+ Sandbox",
      "description": "Лёгкая сборка с QoL модами. Подойдёт для обычной игры.",
      "icon": "https://raw.githubusercontent.com/github/explore/main/topics/react/react.png",
      "forgeVersion": "1.12.2-forge-14.23.5.2860",
      "github": {
        "OWNER": "your-github",
        "REPO": "your-light-pack",
        "BRANCH": "main",
        "SUBDIR": "mods"
      }
    }
  ],
  "SHADERPACKS_GITHUB": {
    "OWNER": "your-github",
    "REPO": "shaderpacks",
    "BRANCH": "main"
  },
  "RESOURCEPACKS_GITHUB": {
    "OWNER": "your-github",
    "REPO": "resourcepacks",
    "BRANCH": "main"
  },
  "SERVERS": [
    {
      "id": "main",
      "name": "Project Server",
      "address": "play.example.com",
      "port": 25565,
      "refreshIntervalSeconds": 45,
      "statusApi": null,
      "rcon": {
        "host": "play.example.com",
        "port": 25575,
        "password": "CHANGE_ME",
        "timeoutMs": 5000,
        "listCommand": "list",
        "tpsCommand": "tps"
      }
    }
  ],
  
  "MCLC_OVERRIDES": {
    "url": {
      "meta": "https://raw.githubusercontent.com/Carisky/mc_launcher_runtime/main/meta",
      "resource": "https://raw.githubusercontent.com/Carisky/mc_launcher_runtime/main/profiles/dtm/assets/objects",
      "mavenForge": "https://raw.githubusercontent.com/Carisky/mc_launcher_runtime/main/profiles/dtm/libraries/",
      "defaultRepoForge": "https://raw.githubusercontent.com/Carisky/mc_launcher_runtime/main/profiles/dtm/libraries/",
      "fallbackMaven": "https://raw.githubusercontent.com/Carisky/mc_launcher_runtime/main/profiles/dtm/libraries/"
    }
  },
  "DELETE_EXTRA_MODS": true
}
